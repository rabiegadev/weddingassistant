// MySQL (MariaDB) na SEOHost — użyj DATABASE_URL w .env
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
}

enum SessionScope {
  CLIENT
  ADMIN
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  /// Zamówienie płatne — klient powinien uiścić bramkę (Przelewy24 / PayU).
  AWAITING_PAYMENT
  PENDING_REVIEW
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Pakiet z katalogu (cennik + zamówienia). `planTier` + `postWeddingAccessMonths` sterują dostępem.
enum PlanTier {
  FREE
  ASSIST_BASIC
  WWW_TEMPLATE
  ASSIST_BASIC_WWW_TEMPLATE
  ASSIST_PREMIUM_WWW_TEMPLATE
  ASSIST_PREMIUM_WWW_CUSTOM
}

enum PaymentProvider {
  PAYU
  PRZELEWY24
  MANUAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ContactInquiryStatus {
  NEW
  READ
  ARCHIVED
}

/// Po logowaniu hasłem admin: false do czasu weryfikacji TOTP lub dokończenia setupu. Klient: zawsze true.
model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  /// Null, gdy konto wyłącznie przez Google (logowanie hasłem niedostępne).
  passwordHash String?
  /// Unikalny identyfikator konta Google (OpenID `sub`).
  googleSub String? @unique
  emailVerifiedAt DateTime?

  role UserRole

  /// Sekret TOTP w base32 (dla roli admin); włączone gdy `totpEnabledAt` uzupełnione
  totpSecret    String?   @db.VarChar(64)
  totpEnabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  orders             Order[]
  messages           OrderMessage[]
  emailVerifications EmailVerificationToken[]
  passwordResets     PasswordResetToken[]

  orderEvents  OrderEvent[] @relation("EventActor")
  auditEntries AuditLog[]
  weddingPageRequests WeddingPageRequest[]

  clientProfile     ClientProfile?
  plannerGuests     PlannerGuest[]
  plannerBudgetLines PlannerBudgetLine[]
  subscriptions     UserSubscription[]
}

model Session {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String
  scope       SessionScope
  expiresAt   DateTime
  mfaComplete Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@unique([tokenHash])
  @@index([userId])
  @@index([scope])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([tokenHash])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([tokenHash])
  @@index([userId])
}

/// Prosty rate limit (najpierw auth); klucz np. "login:email:ip"
model RateLimitEntry {
  id           String   @id @default(cuid())
  key          String   @unique
  count        Int
  windowEndsAt DateTime
  createdAt    DateTime @default(now())
}

/// Dane profilowe pary pod workflow (data ślubu, reset planera Free).
model ClientProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Data ślubu — kotwica do wyliczania końca dostępu płatnych pakietów.
  weddingDate DateTime?

  /// Ostatni automatyczny reset danych planera (plan Free, co tydzień).
  lastFreePlannerResetAt DateTime?

  /// Pola strukturalne „bazy informacji” (JSON) — rozszerzane bez migracji.
  infoJson String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Goście w module planera (plan Free: usuwane przy tygodniowym resecie).
model PlannerGuest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String   @db.VarChar(200)
  createdAt   DateTime @default(now())

  @@index([userId])
}

/// Wydatki w prostym planerze budżetu (plan Free: usuwane przy resecie).
model PlannerBudgetLine {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(200)
  amountCents Int
  createdAt   DateTime @default(now())

  @@index([userId])
}

/// Aktywny dostęp po opłaceniu zamówienia — ważny do `endsAt` (wg pakietu i daty ślubu).
model UserSubscription {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  /// Zamówienie, z którego powstała subskrypcja (opcjonalnie).
  sourceOrderId String? @unique
  order         Order?  @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)

  startedAt DateTime @default(now())
  endsAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([endsAt])
}

/// Pakiet / szablon ofertowy; jeden katalog: publiczny cennik + wybór klienta
model Package {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String   @db.Text
  priceCents   Int
  /// JSON: np. { "weddingPage": true, "gallery": false, "qr": "limited" } — rozszerzamy w seedzie.
  featuresJson String   @db.Text

  planTier                 PlanTier @default(FREE)
  /// null = brak okna „po ślubie” (Free); 6 = pakiety 2–4; 12 = pakiety 5–6 (z możliwością przedłużenia — osobno).
  postWeddingAccessMonths Int?

  sortOrder    Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
  subscriptions UserSubscription[]

  @@index([isPublished, sortOrder])
}

model Order {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId     String
  package       Package        @relation(fields: [packageId], references: [id])
  status        OrderStatus    @default(DRAFT)
  totalCents    Int
  /// Snapshot wyboru klienta
  selectionJson String         @db.Text
  lastMessageAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  events        OrderEvent[]
  messages      OrderMessage[]
  payment       Payment?
  subscription  UserSubscription?

  @@index([userId, status])
  @@index([status])
  @@index([packageId])
}

model Payment {
  id        String          @id @default(cuid())
  orderId   String          @unique
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider  PaymentProvider
  /// Id transakcji u operatora (PayU / Przelewy24).
  externalOrderId String?   @db.VarChar(191)
  status    PaymentStatus   @default(PENDING)
  amountCents Int
  currency  String          @default("PLN") @db.VarChar(8)
  rawNotifyJson String?     @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model OrderEvent {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  message     String?      @db.Text
  createdById String?
  createdBy   User?        @relation("EventActor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
}

model OrderMessage {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isFromAdmin Boolean
  body        String   @db.VarChar(8000)
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([authorId])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action      String   @db.VarChar(100)
  targetType  String   @db.VarChar(100)
  targetId    String   @db.VarChar(64)
  detailsJson String?  @db.Text
  createdAt   DateTime @default(now())
}

/// Zapytania z formularza kontaktowego (publiczny endpoint).
model ContactInquiry {
  id        String               @id @default(cuid())
  name      String                 @db.VarChar(200)
  email     String                 @db.VarChar(320)
  phone     String?                @db.VarChar(40)
  message   String                 @db.VarChar(8000)
  status    ContactInquiryStatus   @default(NEW)
  sourcePage String?               @db.VarChar(200)
  createdAt DateTime               @default(now())

  @@index([status, createdAt])
}

enum WeddingPageRequestStatus {
  NEW
  IN_REVIEW
  IN_PROGRESS
  AWAITING_CLIENT
  DONE
  CANCELLED
}

/// Zgłoszenie realizacji strony weselnej (workflow operacyjny).
model WeddingPageRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      WeddingPageRequestStatus @default(NEW)
  /// Notatka wewnętrzna obsługi (niewidoczna dla pary w MVP).
  internalNote String? @db.VarChar(8000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// Rejestr wysłanych powiadomień (e-mail / później SMS).
model NotificationLog {
  id          String   @id @default(cuid())
  channel     String   @db.VarChar(32)
  templateKey String?  @db.VarChar(80)
  toEmail     String?  @db.VarChar(320)
  subject     String?  @db.VarChar(500)
  bodyPreview String?  @db.VarChar(600)
  metaJson    String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
